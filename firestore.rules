rules_version = '2';

// Regulile aplicației noi (ADR 0039 §7). Totul e refuzat implicit, deci și colecțiile aplicației vechi (`PLAN.md` §3.4 și
// §8.2, decizia 22). Scrierile vin doar de la server (Admin SDK, care nu trece prin reguli), prin callable-uri.
// Probate pe emulator (`npm run test:emulator`); publicate pe test odată cu fila Erori (felia 3.3, ADR 0040).
service cloud.firestore {
  match /databases/{database}/documents {

    // Personalul (ADR 0049): rolul are o singură sursă, `staff/{uid}.rol`: `owner` (tot, plus administrarea personalului)
    // sau id-ul unui rol din `roluri/{id}`, cu permisiunile lui din catalogul din cod (`shared/personal.ts`). Se citesc la
    // fiecare cerere, deci o permisiune scoasă dintr-un rol nu mai deschide nimic de la cererea următoare. Un rol
    // necunoscut (și treptele vechi din ADR 0040) nu dă nimic.
    function caleStaff() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }
    function rolul() {
      return request.auth != null && exists(caleStaff()) ? get(caleStaff()).data.get('rol', '') : '';
    }
    function eOwner() {
      return rolul() == 'owner';
    }
    function permisiuniRol(r) {
      return r is string && r.matches('^[A-Za-z0-9]{20}$') && exists(/databases/$(database)/documents/roluri/$(r))
        ? get(/databases/$(database)/documents/roluri/$(r)).data.get('permisiuni', [])
        : [];
    }
    function are(p) {
      let r = rolul();
      return r == 'owner' || (permisiuniRol(r) is list && permisiuniRol(r).hasAny([p]));
    }

    // Fiecare își citește documentul lui (pagina arată filele după el); owner-ul citește tot personalul.
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || eOwner());
      allow list: if eOwner();
    }

    // Rolurile: fiecare își citește rolul lui; owner-ul le citește pe toate.
    match /roluri/{id} {
      allow get: if eOwner() || (request.auth != null && rolul() == id);
      allow list: if eOwner();
    }

    // Invitațiile (ADR 0049 §4): doar owner-ul.
    match /invitatiiPersonal/{id} {
      allow read: if eOwner();
    }

    // Sugestiile personalului (ADR 0107), scrise doar de callable-ul `sugestii`: cei cu `sugestii.citeste` (și owner-ul) le
    // citesc pe toate; cei cu `sugestii.scrie`, doar pe ale lor (o listă trebuie să filtreze ea `autor` pe uid-ul omului).
    // Contoarele zilnice (`limiteSugestii`) n-au regulă: le citește și le scrie doar serverul.
    match /sugestii/{id} {
      allow read: if are('sugestii.citeste') || (are('sugestii.scrie') && resource.data.autor == request.auth.uid);
    }

    match /errorLogs/{amprenta} {
      allow read: if are('erori.citeste');

      match /aparitii/{id} {
        allow read: if are('erori.citeste');
      }
    }

    // Marcajele de rulare ale joburilor (ADR 0041 §5): scrise doar de joburi; citite de Diagnoză.
    match /marcaje/{job} {
      allow read: if are('diagnoza.citeste');
    }

    // Amprenta publicării (ADR 0044): scrisă doar de scriptul de publicare (prin IAM, nu prin reguli); citită de Diagnoză.
    // Restul colecției `meta` rămâne refuzat.
    match /meta/deployment {
      allow read: if are('diagnoza.citeste');
    }

    // Auditul (ADR 0040 §4): scris doar de callable-uri, în tranzacția acțiunii.
    match /audit/{id} {
      allow read: if are('audit.citeste');
    }
  }
}
